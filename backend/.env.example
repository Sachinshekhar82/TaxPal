PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/taxpal?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Notification Provider Configuration (Resend or SMTP)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=TaxPal <notifications@taxpal.com>

# Optional SMTP Configuration (if not using Resend)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
